# Shopify Admin API (custom app with write_online_store_navigation, read/write_content, read/write_products scopes)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Public storefront origin, used by --verify to HTTP-check redirects
SITE_URL=https://example.com

# shopify-noindex.js — numeric ID of the blog that holds the articles
SHOPIFY_BLOG_ID=123456789

# Input files (paths relative to where you run the command)
REDIRECTS_FILE=redirects.json
NOINDEX_FILE=noindex.json

# noindex-thin-collections.js
MIN_PRODUCTS=4
NOINDEX_STATE_FILE=.noindexed-collections.json
